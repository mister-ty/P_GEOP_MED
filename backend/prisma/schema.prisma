// Prisma schema sincronizado con la BD creada por init.sql.
// NO usar "prisma migrate" — usar "prisma db pull" para introspectar.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Generate binaries for both OpenSSL versions found across builder/runner stages
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model Comuna {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre         String         @db.VarChar(120)
  codigo         String         @unique @db.VarChar(10)
  geometria      Unsupported("geometry(MultiPolygon,4326)")
  intervenciones Intervencion[]
}

model Intervencion {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  comunaId       String   @db.Uuid
  comuna         Comuna   @relation(fields: [comunaId], references: [id], onDelete: Cascade)
  direccion      String   @db.VarChar(255)
  autocadDwgUrl  String?
  pointCloudUrl  String?
  ortofotoUrl    String?
  coordenadas    Unsupported("geometry(Point,4326)")
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @default(now()) @db.Timestamptz()
}
